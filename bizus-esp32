Location: clique em "Browse" e escolha C:\Users\vinic\Desktop\
Clique em "Finish"

5) localize o arquivo src/main.cpp e substitua o conteúdo por:

#include <Arduino.h>

void setup() {
  Serial.begin(115200);
  pinMode(2, OUTPUT);  // Pino 2 do ESP32 (LED onboard em muitas placas)
  Serial.println("Programa iniciado!");
}

void loop() {
  digitalWrite(2, HIGH);
  Serial.println("LED ligado");
  delay(1000);
  
  digitalWrite(2, LOW);
  Serial.println("LED desligado");
  delay(1000);
}


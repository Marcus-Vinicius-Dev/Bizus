📦 GERENCIAMENTO DE DEPENDÊNCIAS
bash
# Adicionar dependências (precisa do cargo-edit: cargo install cargo-edit)
cargo add rand                                    # Adiciona última versão
cargo add rand@0.8.5                              # Adiciona versão específica

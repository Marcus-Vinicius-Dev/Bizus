cargo rm --dev pretty_assertions                  # Remove dependência de desenvolvimento

# Atualizar dependências
cargo update                                      # Atualiza TODAS dependências (dentro do semver)
cargo update -p rand                              # Atualiza apenas a dependência rand
cargo update --precise 0.8.5 -p rand              # Atualiza para versão específica
cargo update --dry-run                            # Mostra o que seria atualizado (sem fazer)

# Listar dependências
cargo tree                                        # Mostra árvore de dependências
cargo tree --duplicates                           # Mostra dependências duplicadas
cargo tree --depth 2                              # Limita profundidade da árvore
cargo tree --invert --package rand                # Mostra quem depende de rand
cargo tree --prefix none                          # Remove prefixo de saída

# Verificar dependências desatualizadas
cargo outdated                                    # Precisa de: cargo install cargo-outdated

🔍 INSPEÇÃO E ANÁLISE
bash
# Verificação sem compilar
cargo check                                       # Verifica sintaxe e tipos (MAIS RÁPIDO!)
cargo check --release                             # Verifica modo release
cargo check --target wasm32-unknown-unknown       # Verifica para target específico

# Análise estática (linter)
cargo clippy                                      # Executa linter (recomendações)
cargo clippy -- -W clippy::pedantic               # Regras pedantes (mais rigoroso)
cargo clippy -- -A clippy::all                    # Desativa todas as regras
cargo clippy --fix                                # Corrige problemas automaticamente
cargo clippy --tests                              # Analisa também códigos de teste
cargo clippy -- --deny warnings                   # Trata warnings como erros

# Formatação de código
cargo fmt                                         # Formata TODO o código
cargo fmt -- --check                              # Apenas verifica, não modifica
cargo fmt -- --config max_width=100               # Formata com largura máxima 100
cargo fmt --all                                   # Formata todos os alvos (bin, lib, tests)

# Documentação
cargo doc                                         # Gera documentação
cargo doc --open                                  # Gera e ABRE no navegador
cargo doc --no-deps                               # Documenta só seu código (não dependências)
cargo doc --document-private-items                # Documenta itens privados também

# Informações do projeto
cargo metadata                                    # Mostra JSON com estrutura do projeto
cargo metadata --format-version 1                 # Versão específica do formato
cargo locate-project                              # Mostra caminho do Cargo.toml
cargo pkgid                                       # Mostra ID completo do pacote
cargo pkgid -p rand                               # Mostra ID de uma dependência


############################################## COMANDOS ##############################################

🆕 CRIANDO PROJETOS
bash
# Projeto executável (binário)
cargo new meu_projeto --bin                       # Cria projeto com src/main.rs
cargo new --bin meu_projeto                       # Mesmo comando (--bin é padrão)

# Projeto biblioteca (pode ser usado por outros projetos)
cargo new minha_lib --lib                         # Cria projeto com src/lib.rs

# Em uma pasta já existente (não cria nova pasta)
cargo init --bin                                  # Inicializa projeto na pasta atual
cargo init --lib                                  # Inicializa biblioteca na pasta atual

# Com configurações extras
cargo new meu_projeto --bin --vcs git             # Já inicializa repositório Git
cargo new meu_projeto --bin --edition 2021        # Define edição específica

🔨 COMPILAÇÃO (BUILD)
bash
# Compilação básica
cargo build                                       # Compila em modo debug
cargo build --release                             # Compila com otimizações (mais rápido)
cargo build --target x86_64-pc-windows-msvc       # Compila para target específico

# Compilação com informações extras
cargo build --verbose                             # Mostra TODOS os comandos executados
cargo build --quiet                               # Saída silenciosa (só erros)
cargo build --color always                        # Força cores na saída

# Compilação com features (dependências condicionais)
cargo build --features "feature1,feature2"        # Ativa features específicas
cargo build --all-features                        # Ativa todas as features
cargo build --no-default-features                 # Desativa features padrão

# Compilação com profiling
cargo build --profile dev                         # Debug (padrão)
cargo build --profile release                     # Release otimizado
cargo build --profile test                        # Perfil de testes

# Compilação de exemplos
cargo build --examples                            # Compila todos os exemplos
cargo build --example meu_exemplo                 # Compila exemplo específico

🏃 EXECUÇÃO
bash
# Execução básica
cargo run                                         # Compila (se necessário) e executa
cargo run --release                               # Executa versão otimizada

# Passando argumentos para o programa (APÓS -- )
cargo run -- arg1 arg2 "argumento com espaço"     # Argumentos vão para seu programa
cargo run -- --help                               # Seu programa recebe --help
cargo run -- -n 10 -f arquivo.txt                 # Seu programa recebe parâmetros

# Execução com features
cargo run --features "feature1"                   # Ativa features e executa

# Execução de exemplos
cargo run --example meu_exemplo                   # Compila e executa um exemplo
cargo run --example meu_exemplo -- arg1 arg2      # Exemplo + argumentos

# Execução de binários específicos
cargo run --bin meu_binario                       # Se tiver múltiplos binários
cargo run --bin meu_binario -- arg1               # Binário específico + argumentos

🧪 TESTES
bash
